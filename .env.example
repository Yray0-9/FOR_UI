# SafeBooks environment configuration
# Copy this file to .env and update values for your machine.

# 0 = SQLite mode (default)
# 1 = PostgreSQL mode
SAFEBOOKS_USE_POSTGRESQL=0

# PostgreSQL settings (used only when SAFEBOOKS_USE_POSTGRESQL=1)
SAFEBOOKS_DB_NAME=safebooks_db
SAFEBOOKS_DB_USER=safebooks_user
SAFEBOOKS_DB_PASSWORD=replace_me
SAFEBOOKS_DB_HOST=localhost
SAFEBOOKS_DB_PORT=5432
# Optional: disable if not needed in local development
# SAFEBOOKS_DB_SSLMODE=prefer

# Optional compatibility aliases (if you already use these names)
# POSTGRES_DB=safebooks_db
# POSTGRES_USER=safebooks_user
# POSTGRES_PASSWORD=replace_me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Email (SMTP) settings
# When SAFEBOOKS_EMAIL_HOST is set, SMTP will be used automatically.
# Do not store real credentials here. Put them in your local .env file.
SAFEBOOKS_EMAIL_HOST=smtp.gmail.com
SAFEBOOKS_EMAIL_PORT=587
SAFEBOOKS_EMAIL_HOST_USER=your_gmail@gmail.com
SAFEBOOKS_EMAIL_HOST_PASSWORD=replace_me
SAFEBOOKS_EMAIL_USE_TLS=1
SAFEBOOKS_EMAIL_USE_SSL=0
SAFEBOOKS_DEFAULT_FROM_EMAIL=SafeBooks <your_gmail@gmail.com>
# Optional override if you want to force a backend
# SAFEBOOKS_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
