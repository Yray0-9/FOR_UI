# SafeBooks environment configuration
# Copy this file to .env and update values for your machine.

# 0 = SQLite mode (default)
# 1 = PostgreSQL mode
SAFEBOOKS_USE_POSTGRESQL=0

# PostgreSQL settings (used only when SAFEBOOKS_USE_POSTGRESQL=1)
SAFEBOOKS_DB_NAME=safebooks_db
SAFEBOOKS_DB_USER=safebooks_user
SAFEBOOKS_DB_PASSWORD=replace_me
SAFEBOOKS_DB_HOST=localhost
SAFEBOOKS_DB_PORT=5432
# Optional: disable if not needed in local development
# SAFEBOOKS_DB_SSLMODE=prefer

# Optional compatibility aliases (if you already use these names)
# POSTGRES_DB=safebooks_db
# POSTGRES_USER=safebooks_user
# POSTGRES_PASSWORD=replace_me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
